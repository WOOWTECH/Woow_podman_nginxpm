#!/usr/bin/env bash
set -u
state=${FAKE_RUNTIME_STATE:?}; resources=$state/resources; events=$state/events
mkdir -p "$state" "$state/data" "$state/letsencrypt"; touch "$resources" "$events"
printf 'compose %s\n' "$*" >>"$events"
if [[ ${1:-} == version ]]; then printf 'podman version 4.9.3\npodman-compose version 1.0.6\n'; exit 0; fi
[[ ${1:-} == -f ]] || exit 3; shift 2
cmd=${1:-}; shift || true
fail_once() {
  [[ ${FAKE_FAIL_ONCE:-} == "$1" && ! -e $state/failed.$1 ]] || return 1
  : >"$state/failed.$1"; printf 'injected failure: %s\n' "$1" >&2; return 0
}
record_lifecycle_fd() {
  local operation=$1 status=closed
  [[ ! -e /proc/$$/fd/9 ]] || status=open
  printf 'lifecycle-fd9 %s %s\n' "$status" "$operation" >>"$events"
  [[ ${FAKE_REQUIRE_LIFECYCLE_FD_CLOSED:-0} != 1 || $status == closed ]]
}
hold_launch() {
  [[ ${FAKE_HOLD_LAUNCH:-} == "$1" ]] || return 0
  : >"$state/launch-held"
  while [[ ! -e $state/launch-release ]]; do sleep 0.05; done
}
remove_type() { awk -v t="$1" '$1!=t' "$resources" >"$resources.tmp" && mv "$resources.tmp" "$resources"; }
case $cmd in
  config) fail_once config && exit 42; exit 0;;
  pull) fail_once pull && exit 42; exit 0;;
  up)
    record_lifecycle_fd compose-up || exit 97
    hold_launch compose-up
    fail_once up && exit 42
    owner=${NPM_OWNER_ID:?}
    awk '$1!="container"&&$1!="network"' "$resources" >"$resources.tmp" && mv "$resources.tmp" "$resources"
    grep -q '^volume npm-app-data ' "$resources" || printf 'volume npm-app-data true %s x x %s\n' "$owner" "$state/data" >>"$resources"
    grep -q '^volume npm-letsencrypt ' "$resources" || printf 'volume npm-letsencrypt true %s x x %s\n' "$owner" "$state/letsencrypt" >>"$resources"
    printf 'network npm-network true %s x x x\ncontainer npm-app true %s %s %s x\n' "$owner" "$owner" "${FAKE_CONTAINER_RUNNING:-true}" "${FAKE_CONTAINER_HEALTH:-healthy}" >>"$resources"
    exit 0;;
  down)
    fail_once down && exit 42
    awk '$1!="container"&&$1!="network"' "$resources" >"$resources.tmp" && mv "$resources.tmp" "$resources"
    exit 0;;
  *) echo "unsupported fake compose invocation: $cmd" >&2; exit 3;;
esac
