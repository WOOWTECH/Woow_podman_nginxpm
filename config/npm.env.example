# ~/.config/npm/npm.env (mode 0600), created from this file by scripts/install.sh
# on the first run (scripts/migrate-legacy.sh fills it from the running legacy
# container instead).
#
# Read only by the install/upgrade scripts, which render these values into the
# unit (decision D2). systemd and podman never read this file, and it holds no
# secret: NPM keeps its admin users, access lists and keys in npm-app-data.
# One KEY=value per line: no quotes, no "export", no comments after a value.

# Container timezone, an IANA name.
NPM_TZ=Asia/Taipei

# Host ports published on every interface for NPM's HTTP and HTTPS listeners.
NPM_HTTP_PORT=80
NPM_HTTPS_PORT=443

# Host port for the admin UI. Always published on 127.0.0.1 only.
NPM_ADMIN_PORT=81

# Extra host ports into the HTTP listener, space separated (for example 30142
# for a Cloudflare route that targets localhost:30142). Empty = none.
NPM_EXTRA_HTTP_PORTS=

# true: NPM also joins the pi-agent network and loads the Host/Origin rewrite
# for pi-web (Woow_podman_pi_agent_package). Set with install.sh --with-pi-web-front.
NPM_PI_WEB_FRONT=false
